# Vercel Blob 读写令牌：在 Vercel 项目里绑定 Blob 后自动注入，
# 也可在 Vercel Blob 控制台手动创建一个复制的 token 填到这里
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# 提供给前端 imgUploader（@aws-sdk/client-s3）使用的 S3 凭证
# 网关会用它校验签名，务必用不易猜测的强随机串
S3_ACCESS_KEY=twikoo-blob
S3_SECRET_KEY=change-me-into-a-long-random-secret